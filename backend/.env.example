# Copy to .env and fill in.
STORE_NAME=Annapurna Silks
# Shared key for the store's Android devices and the admin page. Make it long and random.
API_KEY=change-me

# mock = offline demo images (free), gemini = real AI try-on
ENGINE=mock
GEMINI_API_KEY=
# Interactions API (current) or classic generateContent; switch if one gives 404 for your model
GEMINI_API_STYLE=interactions
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TEXT_MODEL=gemini-flash-latest
IMAGE_SIZE=1K
ASPECT_RATIO=3:4
MAX_CONCURRENT_GENERATIONS=3

# Privacy: customer photos and generated looks are deleted after this many minutes
PHOTO_TTL_MINUTES=30
SESSION_TTL_MINUTES=120
DATA_DIR=data
